# Database Configuration (never commit real values — copy to .env)
DB_USER=postgres
DB_PASSWORD=change_me_use_a_strong_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=garbage_detection_db

# ML Model Path (point at your trained weights)
MODEL_PATH=./backend/ml/best.pt

# Single confidence threshold for YOLO inference (tune via PR curve)
CONFIDENCE_THRESHOLD=0.25

# Per-class bars (JSON override). Defaults already encode the validation
# findings: plastic high (background FPs), metal/glass/styrofoam low.
# PER_CLASS_CONF={"Plastic Waste": 0.5}

# NMS IoU + min box-area fraction (tiny-noise-box filter)
IOU_THRESHOLD=0.5
MIN_BOX_AREA_FRAC=0.0008

# Max image upload size in MB
MAX_UPLOAD_MB=10

# CORS: comma-separated dashboard origin(s). No "*" in production.
ALLOWED_ORIGINS=http://localhost:5173

# Admin API key guarding PATCH /reports/{id}/status (send as X-API-Key header).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_generate_a_random_token

# Upload Directory (optional, defaults to backend/uploads)
# UPLOAD_DIR=backend/uploads
